# Database URL (SQLite default for zero-config local run; or postgresql://user:pass@host:5432/dbname)
DATABASE_URL="file:./dev.db"

# Session Secret for secure JWT / cookie signing
SESSION_SECRET="your-secure-session-secret-at-least-32-chars-long"

# OpenRouter API Key for AI meeting extraction pipeline
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Configurable AI Model (e.g. meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free, openai/gpt-4o-mini)
AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
